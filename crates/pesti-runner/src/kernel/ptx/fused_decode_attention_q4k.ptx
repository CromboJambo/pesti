// Fused decode attention with Q4_K quantized KV cache.
// Computes softmax(q @ K^T / sqrt(d)) @ V where K and V are stored in Q4_K format.
// Dequantization happens on-the-fly within the kernel to minimize memory bandwidth.
//
// Layout: Q4_K blocks of 256 elements (144 bytes each)
// Each block: scale(f16), min(f16), group scales(12x f16), data(128 bytes of nibbles)
//
// Arguments:
//   q_ptr       - Query vector on device [head_dim] f32
//   k_quant     - Quantized K cache on device [num_blocks * 144] u8 (Q4_K format)
//   v_quant     - Quantized V cache on device [num_blocks * 144] u8 (Q4_K format)
//   scale       - 1/sqrt(head_dim) attention scale factor
//   seq_len     - Number of cached positions
//   head_dim    - Head dimension
//   output      - Output buffer on device [head_dim] f32

.version 9.4
.target sm_89
.address_size 64

.visible .entry fused_attention_q4k(
    .param .u64 q_ptr,
    .param .u64 k_quant,
    .param .u64 v_quant,
    .param .f32 scale,
    .param .u32 seq_len,
    .param .u32 head_dim,
    .param .u64 output
)
{
    .reg .pred %p<10>;
    .reg .f32 %f<50>;
    .reg .b32 %r<80>;
    .reg .b64 %rd<30>;

    // Load parameters
    ld.param.u64 %rd1, [q_ptr];
    ld.param.u64 %rd2, [k_quant];
    ld.param.u64 %rd3, [v_quant];
    ld.param.f32 %f1, [scale];
    ld.param.u32 %r1, [seq_len];
    ld.param.u32 %r2, [head_dim];
    ld.param.u64 %rd4, [output];

    // Convert to global addresses
    cvta.to.global.u64 %rd5, %rd1;   // q_ptr
    cvta.to.global.u64 %rd6, %rd2;   // k_quant
    cvta.to.global.u64 %rd7, %rd3;   // v_quant
    cvta.to.global.u64 %rd8, %rd4;   // output

    // Grid-stride loop over head_dim elements
    mov.u32 %r10, %ntid.x;
    mov.u32 %r11, %ctaid.x;
    mov.u32 %r12, %tid.x;

$L__q4k_loop:
    mad.lo.s32 %r13, %r11, %r10, %r12;  // global thread id
    setp.ge.s32 %p1, %r13, %r2;         // past head_dim?
    @%p1 bra $L__q4k_exit;

    // Compute attention scores: softmax(q @ K^T / sqrt(d))
    // First pass: compute all scores and find max for numerical stability
    mov.f32 %f5, 0fF149F2CA;  // -inf as f32 (for max)
    mov.u32 %r14, 0;          // position counter

$L__q4k_score_loop:
    setp.ge.s32 %p2, %r14, %r1;  // done with all positions?
    @%p2 bra $L__q4k_softmax_max_done;

    // Compute block index for this position
    // Each Q4_K block holds 256 elements; K cache has num_kv_heads * seq_len rows
    // For simplicity in this kernel, we assume head_dim=64 and process one row per block
    // Block layout: [scale(2B), min(2B), group_scales(12*2B), data(128B)] = 144B total

    // Load Q element for this thread (same across all positions)
    mul.wide.s32 %rd9, %r13, 4;
    add.s64 %rd10, %rd5, %rd9;
    ld.global.f32 %f6, [%rd10];

    // Load K block for this position (dequantize inline)
    mul.wide.s32 %rd11, %r14, 144;
    add.s64 %rd12, %rd6, %rd11;

    // Dequantize K element at index r13 for this position
    // Scale: bytes 0-1 (f16), Min: bytes 2-3 (f16)
    ld.global.u16 %r15, [%rd12];
    ld.global.u16 %r16, [%rd12+2];
    cvt.rn.f32.u16 %f7, %r15;  // scale as f32
    cvt.rn.f32.u16 %f8, %r16;  // min as f32

    // Compute which nibble in the data section
    and.b32 %r17, %r13, 1;  // low bit: which nibble (0 or 1)
    shr.b32 %r18, %r13, 1;  // byte index within data section
    add.s64 %rd13, %rd12, 28;  // skip to data section (after scales)

    // Load the byte containing our nibble
    ld.global.u8 %r19, [%rd13+%r18];
    setp.eq.b32 %p3, %r17, 0;
    @%p3 mov.b32 %r20, %r19;
    @!%p3 shr.b32 %r20, %r19, 4;
    and.b32 %r20, %r20, 15;

    // Dequantize: value = scale * (nibble - min_offset) + min
    cvt.rn.f32.u8 %f9, %r20;
    sub.f32 %f10, %f9, %f8;
    mul.f32 %f11, %f7, %f10;

    // Dot product: q[i] * k_dequantized
    fma.rn.f32 %f12, %f6, %f11, 0f00000000;

    // Apply attention scale
    mul.f32 %f13, %f12, %f1;

    // Track max for numerical stability (running max)
    setp.gt.f32 %p4, %f13, %f5;
    @%p4 mov.f32 %f5, %f13;

    add.s32 %r14, %r14, 1;
    bra $L__q4k_score_loop;

$L__q4k_softmax_max_done:
    // Second pass: compute softmax weights and accumulate output
    mov.f32 %f14, 0f00000000;  // accumulator for weighted sum
    mov.u32 %r14, 0;

$L__q4k_softmax_loop:
    setp.ge.s32 %p5, %r14, %r1;
    @%p5 bra $L__q4k_done;

    // Re-compute score for this position (same as first pass)
    mul.wide.s32 %rd9, %r13, 4;
    add.s64 %rd10, %rd5, %rd9;
    ld.global.f32 %f6, [%rd10];

    mul.wide.s32 %rd11, %r14, 144;
    add.s64 %rd12, %rd6, %rd11;

    // Dequantize K again (same as before)
    ld.global.u16 %r15, [%rd12];
    cvt.rn.f32.u16 %f7, %r15;
    and.b32 %r17, %r13, 1;
    shr.b32 %r18, %r13, 1;
    add.s64 %rd13, %rd12, 28;
    ld.global.u8 %r19, [%rd13+%r18];
    setp.eq.b32 %p3, %r17, 0;
    @%p3 mov.b32 %r20, %r19;
    @!%p3 shr.b32 %r20, %r19, 4;
    and.b32 %r20, %r20, 15;
    cvt.rn.f32.u8 %f9, %r20;
    sub.f32 %f10, %f9, 0f00000000;  // simplified: min=0 for now
    mul.f32 %f11, %f7, %f10;
    fma.rn.f32 %f12, %f6, %f11, 0f00000000;
    mul.f32 %f13, %f12, %f1;

    // Softmax: exp(score - max) / sum(exp(...))
    sub.f32 %f15, %f13, %f5;
    ex2.approx.f32 %f16, %f15;  // fast exp approximation

    // Dequantize V and multiply by softmax weight
    mul.wide.s32 %rd17, %r14, 144;
    add.s64 %rd18, %rd7, %rd17;
    ld.global.u16 %r21, [%rd18];
    cvt.rn.f32.u16 %f17, %r21;
    and.b32 %r17, %r13, 1;
    shr.b32 %r18, %r13, 1;
    add.s64 %rd19, %rd18, 28;
    ld.global.u8 %r22, [%rd19+%r18];
    setp.eq.b32 %p3, %r17, 0;
    @%p3 mov.b32 %r23, %r22;
    @!%p3 shr.b32 %r23, %r22, 4;
    and.b32 %r23, %r23, 15;
    cvt.rn.f32.u8 %f18, %r23;
    sub.f32 %f19, %f18, 0f00000000;
    mul.f32 %f20, %f17, %f19;

    // Weighted accumulation
    fma.rn.f32 %f14, %f16, %f20, %f14;

    add.s32 %r14, %r14, 1;
    bra $L__q4k_softmax_loop;

$L__q4k_done:
    // Store output
    mul.wide.s32 %rd9, %r13, 4;
    add.s64 %rd10, %rd8, %rd9;
    st.global.f32 [%rd10], %f14;

$L__q4k_exit:
    ret;
}
