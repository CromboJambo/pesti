#!/usr/bin/env hemlock
// Process Management Middleware for Hermes Agent
// Spawns, discovers, monitors, and attaches to running processes.

import { exec } from "@stdlib/process";

// Generate command with PID capture wrapper
fn spawn_command(cmd: string): string {
    return `(${cmd}) & echo "PID: $!"`;
}

// Discover process by PID
fn discover_by_pid(pid: i32) {
    let result = exec(`ps -p ${pid} -o pid,stat,etime,cmd --no-headers 2>/dev/null`);
    if (result.exit_code != 0) {
        return null;
    }
    
    // Parse ps output
    let lines = result.output.split("\n");
    if (lines.length == 0 || lines[0].trim() == "") {
        return null;
    }
    
    let parts = lines[0].split(" ");
    if (parts.length < 4) {
        return null;
    }
    
    return {
        pid: i32(parts[0]),
        stat: parts[1],
        etime: parts[2],
        cmd: parts.slice(3).join(" ")
    };
}

// Monitor process with heartbeat feedback
fn monitor(pid: i32, timeout_s: i32, interval_s: i32) {
    let start = time();
    
    while (true) {
        let elapsed = time() - start;
        if (elapsed >= timeout_s) {
            return { status: "timeout", elapsed: elapsed };
        }
        
        let proc = discover_by_pid(pid);
        if (!proc) {
            return { status: "exited", elapsed: elapsed, exit_code: null };
        }
        
        // Heartbeat feedback
        print(`[${elapsed}s] Process still running (PID ${pid})...`);
        
        sleep(interval_s * 1000);
    }
}

// Attach to process for interaction
fn attach(pid: i32) {
    let result = exec(`ps -p ${pid} -o pid,cmd --no-headers 2>/dev/null`);
    if (result.exit_code != 0) {
        return { status: "not_found" };
    }
    
    // For debugging scenarios, suggest gdb attachment
    print("Process found. To debug interactively:");
    print(`  gdb -p ${pid}`);
    print("Or to inspect memory:");
    print(`  cat /proc/${pid}/status`);
    
    return { status: "attached", pid: pid };
}

// Main interface
fn main() {
    let args = process.argv;
    
    if (args.length < 3) {
        print("Usage: process_mgmt.hml <command> <pid|timeout_s>");
        return;
    }
    
    let command = args[1];
    let target = i32(args[2]);
    
    switch (command) {
        case "spawn":
            // args[3] is the actual command to run
            let cmd = args.slice(3).join(" ");
            print(spawn_command(cmd));
            break;
            
        case "discover":
            let proc = discover_by_pid(target);
            if (proc) {
                print(`Found: PID ${proc.pid}, Status: ${proc.stat}, Elapsed: ${proc.etime}`);
                print(`Command: ${proc.cmd}`);
            } else {
                print("Process not found or exited");
            }
            break;
            
        case "monitor":
            // args[3] is timeout, args[4] is interval
            let timeout = target;
            let interval = 5;
            if (args.length > 4) {
                interval = i32(args[4]);
            }
            let result = monitor(i32(args[3]), timeout, interval);
            print(`Monitor result: ${result.status} after ${result.elapsed}s`);
            break;
            
        case "attach":
            attach(target);
            break;
            
        default:
            print("Unknown command. Use: spawn|discover|monitor|attach");
    }
}

main();